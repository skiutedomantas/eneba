DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gamehub
DB_USERNAME=gamehub
DB_PASSWORD=
# PostgreSQL only; one of disable, allow, prefer, require, verify-ca, verify-full.
DB_SSLMODE=prefer

APP_ENV=development
SESSION_COOKIE_SECURE=false

# Generate a random 32-byte key and base64-encode it; retain old versions when rotating.
KEY_ENCRYPTION_KEYS='{"1":"REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY"}'
KEY_ENCRYPTION_KEY_VERSION=1
